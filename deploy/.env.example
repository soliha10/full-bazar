# Serverda /opt/full-bazar/deploy/.env ga nusxalanadi (gitignore da).
POSTGRES_PASSWORD=
JWT_SECRET=
TELEGRAM_BOT_TOKEN=
FEEDBACK_CHAT_ID=

# Ro'yxatdan o'tishda tasdiqlash kodi. Bo'sh qolsa — kanal o'chiq.
# Email: resend.com -> API Keys. Domen (bazarcom.online) Resend da tasdiqlangan bo'lsin.
RESEND_API_KEY=
EMAIL_FROM=Bazarcom <noreply@bazarcom.online>
# SMS: my.eskiz.uz hisobi. ESKIZ_TEMPLATE Eskiz da tasdiqlangan shablon bilan
# harfma-harf bir xil bo'lishi shart; {code} o'rniga kod qo'yiladi.
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
ESKIZ_TEMPLATE=Bazarcom: tasdiqlash kodingiz {code}. Kodni hech kimga bermang.
SERVER_IP=185.174.255.157

# dagster./mlflow. panellari paroli: docker run --rm caddy:2-alpine caddy hash-password
# Bitta tirnoqda yozing — aks holda hash dagi $ belgilarini compose o'zgaruvchi deb oladi
PANEL_PASSWORD_HASH=
